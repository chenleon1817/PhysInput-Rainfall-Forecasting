{
  "project": {"name": "PhysInput-Rainfall-Forecasting", "target_journal": "Pattern Analysis and Applications"},
  "data": {"years": [2020, 2021, 2022, 2023, 2024, 2025], "grid_shape": [9, 5], "input_hours": 12, "prediction_horizon": 1},
  "split": {"train_end": "2024-06-30 23:59:59", "validation_start": "2024-07-01 00:00:00", "validation_end": "2024-12-31 23:59:59", "test_start": "2025-01-01 00:00:00"},
  "training": {"seed": 42, "epochs": 20, "batch_size": 32, "learning_rate": 0.0005, "loss_mode": "grid_weighted_huber", "early_stopping_patience": 8, "reduce_lr_patience": 3, "reduce_lr_factor": 0.5, "minimum_learning_rate": 1e-7, "optimizer": "Adam", "optimizer_clipnorm": 1.0, "model_hyperparameters": {"bilstm": {"dropout_rate": 0.2, "lstm_units": 64}, "convlstm": {"dropout_rate": 0.2}, "cnn_bilstm_attention": {"dropout_rate": 0.15, "lstm_units": 64, "post_temporal_dropout": 0.075}, "cnn_bilstm": {"dropout_rate": 0.15, "lstm_units": 64, "post_temporal_dropout": 0.075}, "physinput_lite": {"dropout_rate": 0.15, "lstm_units": 64, "post_temporal_dropout": 0.075}, "physinput_adv3": {"dropout_rate": 0.15, "lstm_units": 64, "post_temporal_dropout": 0.075}, "physinput_conv3": {"dropout_rate": 0.15, "lstm_units": 64, "post_temporal_dropout": 0.075}, "physinput_all4": {"dropout_rate": 0.15, "lstm_units": 64, "post_temporal_dropout": 0.075}}},
  "sample_balance": {"method": "event_aware_five_class_keep_ratio", "rain_threshold_mm": 0.1, "moderate_threshold_mm": 2.5, "near_heavy_threshold_mm": 7.5, "heavy_threshold_mm": 10.0, "event_neighbor_hours": 3, "keep_ratios": {"no_rain": 0.6, "light": 0.8, "moderate": 1.0, "near_heavy": 1.0, "heavy": 1.0, "event_neighbor": 1.0}, "enable_downsample_no_rain": false, "bucket": "month", "seed": 42, "enable_shared_event_replay": false, "replay": false},
  "sample_weight": {"enabled": true, "method": "y_max_four_class", "rain_threshold": 0.1, "moderate_threshold": 2.5, "heavy_threshold": 10.0, "weights": {"no_rain": 1.0, "light_rain": 1.0, "moderate_rain": 1.5, "heavy_rain": 2.0}},
  "models": ["linear_arx", "bilstm", "convlstm", "cnn_bilstm_attention", "cnn_bilstm", "physinput_lite", "physinput_adv3", "physinput_conv3", "physinput_all4"],
  "evaluation": {"thresholds_mm_per_hour": [0.1, 2.5, 10.0], "clip_predictions_nonnegative": true},
  "runtime": {"deterministic": true, "mixed_precision": false, "use_tfdata": false},
  "checkpoint": {"selection": "best_val_event", "event_threshold_mm_per_hour": 10.0, "event_score": {"csi_weight": 1.0, "pod_weight": 0.20, "far_weight": -0.15, "fbias_absolute_error_weight": -0.10}, "early_stopping_monitor": "val_event_score", "early_stopping_mode": "max", "early_stopping_min_delta": 0.0001, "save_weights_only": true},
  "outputs": {"training_root": "outputs/training", "evaluation_root": "outputs/evaluation", "paper_figures_root": "outputs/paper_figures"}
}
